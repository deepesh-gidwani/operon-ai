# Copy to .env and fill in. Never commit .env.
# Meta Model API key (server-side only — never expose to the frontend).
MODEL_API_KEY=
# Override only if Meta changes the endpoint.
MODEL_API_URL=https://api.meta.ai/v1
# All LLM inference uses this model.
MODEL_NAME=muse-spark-1.3
# Comma-separated origins allowed to call the API (Vite dev server default).
CORS_ORIGINS=http://localhost:5173
# Max CSV upload size in MB.
MAX_UPLOAD_MB=25
# Per-request timeout for Meta Model API calls, in seconds.
LLM_TIMEOUT_S=120
# Bounded retries for transient model failures / malformed JSON.
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=1.0
